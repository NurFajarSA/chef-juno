# Param Functions untuk project produksimu. Salin jadi `apps/functions/.env.<project-id>` (tidak ikut di-commit).
# Bukan rahasia — secret ada di Secret Manager (GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET).
# Service account yang menjalankan Functions
FUNCTIONS_SA=chefjuno-fn@<project-id>.iam.gserviceaccount.com
# ID numerik GitHub admin pertama (JSON array)
BOOTSTRAP_ADMIN_GITHUB_IDS='["12345678"]'
GITHUB_API_URL=https://api.github.com
DASHBOARD_URL=https://<project-id>.web.app
# apiKey config web Firebase (publik; sama dengan /__/firebase/init.json di Hosting)
WEB_API_KEY=<web-api-key>
# slug GitHub App milikmu (github.com/apps/<slug>)
GITHUB_APP_SLUG=<github-app-slug>
