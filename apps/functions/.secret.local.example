# Salin ke .secret.local (gitignored). Nilai DUMMY untuk emulator saja.
# `npm run setup:local` membuat file ini otomatis dengan private key RSA palsu yang dibangkitkan lokal.
GITHUB_APP_ID=12345
GITHUB_WEBHOOK_SECRET=demo-webhook-secret
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nDUMMY\n-----END PRIVATE KEY-----\n"
